# Database (SQLite). Path relatif terhadap folder prisma/schema.prisma
DATABASE_URL="file:../data/app.db"

# API key untuk alat Vital Sign (kirim via header X-API-Key)
DEVICE_API_KEY="ubah-api-key-ini"

# Secret untuk sesi login admin (buat string acak, minimal 32 karakter)
AUTH_SECRET="ubah-secret-acak-ini-minimal-32-karakter"

# Akun admin default (dibuat otomatis saat seeding)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Folder penyimpanan file CSV asli (opsional)
# UPLOAD_DIR="./data/uploads"
