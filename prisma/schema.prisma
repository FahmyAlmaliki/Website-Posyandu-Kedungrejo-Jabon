generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Batch {
  id               String            @id @default(cuid())
  title            String
  uploadedAt       DateTime          @default(now())
  source           String
  deviceType       String            @default("VITAL_SIGN")
  originalFilename String
  filePath         String
  recordCount      Int
  measurements     Measurement[]
  babyMeasurements BabyMeasurement[]
}

model Measurement {
  id                String  @id @default(cuid())
  batchId           String
  batch             Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  sessionId         String?
  nama              String?
  tanggalLahir      String?
  umurBulan         Float?
  gender            String?
  kategoriTinggi    String?
  tinggiCm          Float?
  beratKg           Float?
  suhuC             Float?
  hrBpm             Int?
  spo2Pct           Float?
  fsRedirHz         Float?
  fsGreenHz         Float?
  fsResampleHz      Int?
  fsKualitasOk      Boolean?
  durasiKualitasOk  Boolean?
  nSamplePpg        Int?
  glukosaMgdl       Float?
  glukosaStatus     String?

  @@index([batchId])
}

model BabyMeasurement {
  id                String  @id @default(cuid())
  batchId           String
  batch             Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  sessionId         String?
  nama              String?
  tanggalLahir      String?
  gender            String?
  usiaBulan         Float?
  beratKg           Float?
  panjangCm         Float?
  standar           String?
  statusPbU         String?
  statusBbU         String?
  statusBbPb        String?
  statusKeseluruhan String?

  @@index([batchId])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
